{
  "name": "cloud-job-orchestrator-native",
  "version": "1.1.0",
  "private": true,
  "author": "Jason Stys",
  "description": "A full owner-local PostgreSQL job operations workspace",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:native": "node ../scripts/build-native.mjs",
    "test:native-app": "node ../scripts/test-native-app.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.11.0",
    "electron-builder": "26.18.0"
  },
  "overrides": { "minimatch@>=7 <11.0.1": "11.0.1" },
  "build": {
    "appId": "com.jasonstys.cloudjoborchestrator",
    "productName": "Cloud Job Orchestrator",
    "directories": { "output": "../release/native" },
    "files": ["*.cjs", "package.json"],
    "extraResources": [{ "from": "../.runtime/native-resources", "to": "native" }],
    "win": { "target": "dir", "executableName": "CloudJobOrchestrator", "signExecutable": false },
    "asar": true
  }
}
